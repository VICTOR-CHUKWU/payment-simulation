NODE_ENV=development
LOG_LEVEL=info
AUTH_PORT=3001
PAYMENT_PORT=3002
NOTIFICATION_PORT=3003
NATS_URL=nats://localhost:4222
STORAGE_DRIVER=file
DATA_DIR=data
SEED_ADMIN_EMAIL=admin@example.com
SEED_USER_EMAIL=user@example.com
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
PROCESSOR_POLL_INTERVAL_MS=1000
PROCESSOR_CONCURRENCY=5
GATEWAY_MIN_DELAY_MS=1000
GATEWAY_MAX_DELAY_MS=5000
GATEWAY_FAILURE_RATE=0.2
GATEWAY_TIMEOUT_RATE=0.05
GATEWAY_TIMEOUT_MS=10000
OUTBOX_RELAY_INTERVAL_MS=1000
# Required in production. Elsewhere auth defaults to these demo values.
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_USER_PASSWORD=User123!
# Required in production, at least 32 characters. Elsewhere services share a dev default.
# JWT_SECRET=1AxryKo+ukcku7KxQ78xeqtbBvFC8q8Z

